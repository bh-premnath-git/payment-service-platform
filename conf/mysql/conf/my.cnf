!includedir /etc/mysql/conf.d/
!includedir /etc/mysql/mysql.conf.d/
[mysqld]
max_connections=1000
# Configure MySQL to use the certificates generated by the mkcert helper
# container. These files are mounted read-only from the shared mkcert volume.
ssl_ca=/certs/rootCA.pem
ssl_cert=/certs/cert.pem
ssl_key=/certs/key.pem
