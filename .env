# Container image and runtime configuration
MYSQL_IMAGE=mysql:8.0.43-debian
MYSQL_PORT=3306
MYSQL_ROOT_PASSWORD=root

# Published HTTPS endpoint for the Identity Server (Key Manager)
ISKM_HTTPS_PORT=9444

# Published API Manager endpoints
APIM_HTTPS_PORT=9443
APIM_GATEWAY_HTTP_PORT=8280
APIM_GATEWAY_HTTPS_PORT=8243

# Shared build arguments
MYSQL_CONNECTOR_VERSION=8.0.32
